<UserControl x:Class="ClientBase.PhotoBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Padding="12">
        <DockPanel>
            <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="15"
                       TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Загрузить…" Padding="10,4" Margin="0,0,6,0" Click="Load_Click"/>
                <Button Content="Из буфера" Padding="10,4" Margin="0,0,6,0" Click="Paste_Click"
                        ToolTip="Вставить картинку, скопированную в другой программе (например, скриншот из Базиса)"/>
                <Button x:Name="RemoveButton" Content="Убрать" Padding="10,4" Click="Remove_Click"/>
            </StackPanel>

            <Border Background="#F7F4EE" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8"
                    AllowDrop="True" Drop="Photo_Drop" MouseLeftButtonUp="Image_Click">
                <Grid>
                    <Image x:Name="Img" Stretch="Uniform" Margin="2" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="Hint" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
                               Text="Нет фото&#10;Перетащите файл сюда или нажмите «Загрузить»"/>
                </Grid>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
