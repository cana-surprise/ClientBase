<Window x:Class="ClientBase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="База клиентов — корпусная мебель"
        Width="1240" Height="800" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen" FontSize="14"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Статус заказа: «Готово» — зелёным, «В производстве» — янтарным, «В разработке» — приглушённо -->
            <Style x:Key="StatusCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="Готово">
                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="В производстве">
                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая панель: клиенты -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" CornerRadius="12" Padding="14">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,12">
                    <Button DockPanel.Dock="Right" Content="⚙  Настройки" Style="{StaticResource SidebarButton}"
                            Padding="10,5" VerticalAlignment="Center" ToolTip="Изготовители, папка с данными"
                            Click="Settings_Click"/>
                    <TextBlock Text="Клиенты" FontSize="23" FontWeight="SemiBold" Foreground="White"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBox x:Name="SearchBox" Style="{StaticResource SidebarTextBox}" Padding="10,8"
                             TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                             ToolTip="Ctrl+F — перейти к поиску"/>
                    <TextBlock Text="Поиск: имя, телефон, e-mail, адрес" Foreground="#8593A0"
                               Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button DockPanel.Dock="Bottom" Content="＋  Новый клиент" Style="{StaticResource PrimaryButton}"
                        Margin="0,10,0,0" Padding="14,10" ToolTip="Ctrl+N" Click="NewClient_Click"/>
                <TextBlock DockPanel.Dock="Bottom" x:Name="CountText" Foreground="#8593A0" FontSize="12.5"
                           Margin="4,10,0,0"/>

                <ListBox x:Name="ClientList" SelectionChanged="ClientList_SelectionChanged"
                         Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         ItemContainerStyle="{StaticResource SidebarListItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding PhonesText}" Foreground="#A3AFBB" FontSize="12.5"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Карточка клиента и заказы -->
        <StackPanel x:Name="EmptyHint" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Выберите клиента слева" FontSize="22" FontWeight="SemiBold"
                       Foreground="#C4CCD3" HorizontalAlignment="Center"/>
            <TextBlock Text="или добавьте нового (Ctrl+N)" FontSize="15" Foreground="#9AA6B0"
                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <Grid x:Name="ClientPanel" Grid.Column="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}">
                <Grid>
                <!-- Режим просмотра: компактно, без полей ввода -->
                <Grid x:Name="ViewPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ViewName" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="ViewPhonesLabel" Grid.Row="0" Text="Телефоны" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,2"/>
                            <TextBlock x:Name="ViewPhones" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Margin="0,2,0,2"/>
                            <TextBlock x:Name="ViewEmailLabel" Grid.Row="1" Text="E-mail" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,2"/>
                            <TextBlock x:Name="ViewEmail" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,2,0,2"/>
                            <TextBlock x:Name="ViewAddressLabel" Grid.Row="2" Text="Адрес" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,2"/>
                            <TextBlock x:Name="ViewAddress" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Margin="0,2,0,2"/>
                            <TextBlock x:Name="ViewNotesLabel" Grid.Row="3" Text="Примечание" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,2"/>
                            <ScrollViewer x:Name="ViewNotesScroll" Grid.Row="3" Grid.Column="1" MaxHeight="70"
                                          VerticalScrollBarVisibility="Auto" Margin="0,2,0,2">
                                <TextBlock x:Name="ViewNotes" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                        <TextBlock x:Name="SavedText" Foreground="{DynamicResource SuccessBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="✎  Редактировать" Padding="14,7" Click="EditClient_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Режим редактирования -->
                <Grid x:Name="EditPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ФИО / организация" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" FontWeight="SemiBold"
                             FontSize="16" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="1" Text="E-mail" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="2" Text="Адрес" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                             Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="3" Text="Телефоны" Foreground="{DynamicResource MutedBrush}"
                               Margin="0,8,0,8" VerticalAlignment="Top"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,2">
                        <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Phones}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="210"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Номер телефона"/>
                                            <TextBox Grid.Column="1" Margin="8,0,0,0"
                                                     Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Пометка (например: жена, рабочий, WhatsApp)"/>
                                            <Button Grid.Column="2" Content="✕" Style="{StaticResource IconButton}"
                                                    Margin="6,0,0,0" ToolTip="Убрать номер" Click="RemovePhone_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Content="＋  Добавить телефон" HorizontalAlignment="Left" Padding="10,4"
                                Click="AddPhone_Click"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Text="Примечание" Foreground="{DynamicResource MutedBrush}"
                               Margin="0,8,0,0" VerticalAlignment="Top"/>
                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,8,0,0">
                        <TextBox x:Name="NotesBox" Height="54" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/>
                        <Thumb Height="14" Cursor="SizeNS" Focusable="False" DragDelta="NotesGrip_DragDelta"
                               ToolTip="Потяните вниз или вверх, чтобы изменить высоту поля">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent">
                                        <Border Width="44" Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                HorizontalAlignment="Center" Background="{DynamicResource InputBorderBrush}"/>
                                    </Border>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </StackPanel>

                    <DockPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,14,0,0" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="Удалить клиента" Style="{StaticResource DangerButton}"
                                Click="DeleteClient_Click"/>
                        <Button DockPanel.Dock="Right" Content="Сохранить" Style="{StaticResource PrimaryButton}"
                                Padding="22,8" ToolTip="Ctrl+S" Click="SaveClient_Click"/>
                        <Button x:Name="CancelEditButton" DockPanel.Dock="Right" Content="Отмена" Margin="0,0,10,0"
                                Padding="18,8" Click="CancelEdit_Click"/>
                    </DockPanel>
                </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Удалить" Style="{StaticResource DangerButton}" Margin="0,0,8,0"
                                    Click="DeleteOrder_Click"/>
                            <Button Content="Открыть" Margin="0,0,8,0" Click="OpenOrder_Click"/>
                            <Button Content="＋  Новый заказ" Style="{StaticResource PrimaryButton}" Click="NewOrder_Click"/>
                        </StackPanel>
                        <TextBlock Text="История заказов" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock DockPanel.Dock="Bottom" x:Name="OrdersSummary" FontWeight="SemiBold" Margin="2,10,0,0"/>

                    <DataGrid x:Name="OrdersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" RowHeight="36" CanUserAddRows="False"
                              MouseDoubleClick="OrdersGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="56"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding DateText}" Width="100"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Заказ" Binding="{Binding Title}" Width="*"
                                                ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="150"
                                                ElementStyle="{StaticResource StatusCell}"/>
                            <DataGridTextColumn Header="Себестоимость" Binding="{Binding CostText}" Width="130"
                                                ElementStyle="{StaticResource CellTextRight}"/>
                            <DataGridTextColumn Header="Цена заказа" Binding="{Binding PriceText}" Width="130"
                                                ElementStyle="{StaticResource CellTextRight}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
