<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Палитра главного окна: приглушённый графитово-сланцевый фон и боковая панель, а карточки клиента и заказов —
        светлые, но не белые (тёплый «льняной» тон). Подключается в MainWindow.Resources и подменяет кисти Theme.xaml,
        поэтому окно заказа остаётся в основной светлой теме.
    -->
    <SolidColorBrush x:Key="BgBrush" Color="#36424C"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#242E37"/>

    <SolidColorBrush x:Key="CardBrush" Color="#E6E1D8"/>
    <SolidColorBrush x:Key="LineBrush" Color="#CFC7B8"/>
    <SolidColorBrush x:Key="LineSoftBrush" Color="#D8D1C4"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#B5A892"/>
    <SolidColorBrush x:Key="NeutralChipBrush" Color="#D9D2C5"/>
    <SolidColorBrush x:Key="ControlBgBrush" Color="#EFEBE3"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#F6F3EC"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#DCD5C7"/>
    <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#BBAF9B"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#F1EEE7"/>
    <SolidColorBrush x:Key="HeaderBrush" Color="#DAD3C6"/>
    <SolidColorBrush x:Key="RowBrush" Color="#EAE6DE"/>
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F1EDE6"/>
</ResourceDictionary>
