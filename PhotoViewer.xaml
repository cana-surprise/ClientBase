<Window x:Class="ClientBase.PhotoViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фото" Width="1100" Height="800" MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#1E1F22" FontSize="14"
        KeyDown="Window_KeyDown">
    <Grid>
        <Image x:Name="Img" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality"
               MouseLeftButtonUp="Img_Click" Cursor="Hand"/>
        <TextBlock Text="Esc или щелчок по фото — закрыть" Foreground="#AAB0BA" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
    </Grid>
</Window>
